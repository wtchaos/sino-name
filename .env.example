# Required in production
APP_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=

# Current DeepSeek default; override without changing code when models evolve.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Upstash Redis REST credentials for anonymous limits and 30-day results.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public production origin used for metadata, sitemap, and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only. Never enable demo mode on the production deployment.
ENABLE_DEMO_MODE=true

# Rate limits are disabled automatically in development and enforced automatically
# when NODE_ENV=production.
